{
  "name": "melovista",
  "version": "1.1.22",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "desktop": "npm run dev --workspace=apps/desktop",
    "mobile": "npm run start --workspace=apps/mobile",
    "bot": "npm run start --workspace=apps/bot",
    "bot:dev": "npm run dev --workspace=apps/bot",
    "server": "npm run start --workspace=apps/server",
    "server:dev": "npm run dev --workspace=apps/server",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "format": "prettier --write .",
    "lint": "eslint .",
    "deploy": "node scripts/deploy.js",
    "deploy:server": "bash scripts/deploy-homelab.sh",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luxaztk/Cross-Platform-Music-Player-App.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Melovista - Cross platform music player (Electron + React Native)",
  "bugs": {
    "url": "https://github.com/Luxaztk/Cross-Platform-Music-Player-App/issues"
  },
  "homepage": "https://github.com/Luxaztk/Cross-Platform-Music-Player-App#readme",
  "overrides": {
    "js-yaml": "^4.2.0",
    "uuid": "^11.1.1",
    "@develar/schema-utils": {
      "ajv": "^6.12.6",
      "ajv-keywords": "^3.5.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
