{
  "name": "melovista-desktop",
  "description": "Cross-Platform Music Player",
  "author": "Luxaztk",
  "private": true,
  "version": "1.1.21",
  "type": "module",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Luxaztk/Cross-Platform-Music-Player-App.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "node node_modules/youtube-dl-exec/scripts/postinstall.js || echo 'Warning: yt-dlp binary download failed!'",
    "build:win": "npm run build && electron-builder --win --publish always",
    "build:mac": "npm run build && electron-builder --mac --publish always",
    "build:local": "npm run build && electron-builder --win",
    "build:fast": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@music/utils": "*",
    "@types/ffmpeg-installer__ffmpeg": "^1.0.2",
    "@types/react-window": "^1.8.8",
    "axios": "^1.7.9",
    "electron-log": "^5.4.3",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.3.9",
    "fuse.js": "^7.1.0",
    "lucide-react": "^1.6.0",
    "music-metadata": "^11.12.3",
    "node-id3": "^0.2.9",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.2.0",
    "react-window": "^2.2.7",
    "youtube-dl-exec": "^3.1.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@rolldown/plugin-babel": "^0.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/react-router-dom": "^5.3.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.0.2",
    "sass-embedded": "^1.98.0",
    "vite": "^8.0.1",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.3"
  },
  "build": {
    "appId": "com.melovista.app",
    "productName": "Melovista",
    "electronVersion": "41.0.3",
    "publish": [
      {
        "provider": "github",
        "owner": "Luxaztk",
        "repo": "Cross-Platform-Music-Player-App",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "**/node_modules/@ffmpeg-installer/win32-x64/**",
      "**/node_modules/youtube-dl-exec/bin/**"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/logo.ico"
    },
    "mac": {
      "icon": "build/logo.icns"
    },
    "linux": {
      "icon": "build"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
