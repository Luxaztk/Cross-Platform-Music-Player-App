# ==========================================
# MELOVISTA DISCORD BOT - CONFIGURATION (.env.example)
# ==========================================

# 1. Bot Authentication Token (Lấy tại Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# 2. Application Client ID (Lấy tại General Information -> Application ID)
CLIENT_ID=your_client_id_here

# 3. Guild Server ID (Chuột phải vào icon Server Discord của bạn -> Copy Server ID)
# Đăng ký Slash Command theo Guild ID sẽ có hiệu lực tức thì (< 1 giây) thay vì phải chờ 1 tiếng
GUILD_ID=your_guild_id_here

# 4. Đường dẫn file Cookie cá nhân (Bypass lỗi 403 / Bot Detection của YouTube)
# Mặc định trỏ tới file youtube_cookies.txt của MeloVista Desktop
COOKIES_PATH=

# 5. Cấu hình Audio Stream (Tùy chọn)
DEFAULT_VOLUME=100
MAX_QUEUE_SIZE=500
