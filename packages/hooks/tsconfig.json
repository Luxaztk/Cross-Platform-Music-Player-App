{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@music/hooks": ["./index.ts"],
      "@music/hooks/types": ["./src/types/index.ts"],
      "@music/hooks/constants": ["./src/constants/index.ts"],
      "@music/hooks/utils": ["./src/utils"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*", "index.ts"]
}

